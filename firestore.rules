rules_version = '2';

// Mktforge — Cloud Firestore security rules
// Paste into: Firebase console → Firestore Database → Rules → Publish.
//
// Every record lives under users/{uid}. Only the signed-in owner of that uid,
// with a verified email address, can read or write it. Everything else is
// denied by default.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /files/{fileId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 200
          && request.resource.data.chunks is int
          && request.resource.data.chunks <= 25
          && (!('textChunks' in request.resource.data)
              || (request.resource.data.textChunks is int && request.resource.data.textChunks <= 5))
          && (!('digest' in request.resource.data)
              || (request.resource.data.digest is string
                  && request.resource.data.digest.size() <= 20000));

        // Text pulled out of the file for Mktforge's agents.
        match /text/{partId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.data is string
            && request.resource.data.data.size() <= 950 * 1024;
        }

        match /chunks/{chunkId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.data is bytes
            && request.resource.data.data.size() <= 750 * 1024;
        }
      }
    }

    // Market Tracker: one document per tracked job title or competitor.
    match /users/{uid}/tracker/{boxId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.rows is list
        && request.resource.data.rows.size() <= 50;
    }

    // Market Tracker: what the agent has already seen on a competitor's site
    // and already reported, so a refresh only shows what is new. Outlives the
    // box; removed when the URL leaves My Company.
    match /users/{uid}/competitorLedger/{ledgerId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 500
        && request.resource.data.inventory is list
        && request.resource.data.inventory.size() <= 2000
        && request.resource.data.surfaced is list
        && request.resource.data.surfaced.size() <= 2000;
    }

    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }
  }
}
